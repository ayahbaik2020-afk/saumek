# Supabase (get from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER commit or expose this key.
# Used by server actions for admin operations (service role bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Company name shown on QR labels / headers
NEXT_PUBLIC_COMPANY_NAME=PT SULFINDO ADIUSAHA

# SIMIP attachment — contoh nyata: N:\workorder\26011225_WR.pdf
# {wonum} = nomor WO asli SIMIP (WONUM), bukan job_number SAUMEK
NEXT_PUBLIC_SIMIP_ATTACHMENT_ROOT=N:\workorder\
NEXT_PUBLIC_SIMIP_ATTACHMENT_TEMPLATE={root}{wonum}_WR.pdf
# Fallback jika pola utama tidak ada (pisahkan koma)
NEXT_PUBLIC_SIMIP_ATTACHMENT_ALTERNATES={root}{wonum}.pdf,{root}{wonum}.jpg,{root}{wonum}.jpeg,{root}{wonum}.xlsx,{root}{wonum}_WR.jpg,{root}{wonum}_WR.jpeg

# Lampiran WO dibaca langsung dari drive N: oleh server Next.js (tidak di-upload ke Supabase).
# Syarat: npm run dev di PC Sulfindo yang drive N:\workorder\ aktif (localhost).
# Di Vercel/cloud, lampiran N: tidak bisa diakses.

# SIMIP (MIPRO/SQL Server) defaults for the in-app sync button.
# User & password are entered by the user in the UI (not stored).
SIMIP_SERVER=192.168.20.10
SIMIP_DATABASE=SAUSIMIP
SIMIP_PORT=1433
SIMIP_ENCRYPT=false

# Opsional: sync-agent di PC Sulfindo bisa baca ini otomatis (tanpa prompt setup)
# Akun SQL Server (BUKAN login aplikasi SIMIP/Maximo seperti hebron.s)
# Contoh akun SQL read-only: saumek_sync (minta ke IT jika belum punya)
# SIMIP_USER=saumek_sync
# SIMIP_PASSWORD=
