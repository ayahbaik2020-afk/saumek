# Supabase (get from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER commit or expose this key.
# Used by server actions for admin operations (service role bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Company name shown on QR labels / headers
NEXT_PUBLIC_COMPANY_NAME=PT SULFINDO ADIUSAHA

# SIMIP (MIPRO/SQL Server) defaults for the in-app sync button.
# User & password are entered by the user in the UI (not stored).
SIMIP_SERVER=192.168.20.10
SIMIP_DATABASE=SAUSIMIP
SIMIP_PORT=1433
SIMIP_ENCRYPT=false
